<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight: every colour below resolves from values/ or values-night/ automatically,
         and isLightTheme drives the WebView's own dark rendering. -->
    <style name="Theme.CleanGram" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>

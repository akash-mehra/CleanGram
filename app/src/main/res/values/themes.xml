<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CleanGram" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/shell_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorAccent">@color/shell_accent</item>
        <item name="android:colorBackground">@color/shell_background</item>
        <item name="android:textColorPrimary">@color/shell_text</item>
        <item name="android:textColorSecondary">@color/shell_secondary</item>
        <item name="android:fontFamily">sans</item>
        <item name="buttonStyle">@style/Widget.CleanGram.Button</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.CleanGram.Dialog</item>
    </style>
    <style name="ThemeOverlay.CleanGram.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/shell_accent</item>
        <item name="android:windowBackground">@drawable/shell_dialog_background</item>
        <item name="android:colorBackground">@color/shell_surface</item>
        <item name="android:textColorPrimary">@color/shell_text</item>
        <item name="android:textColorSecondary">@color/shell_secondary</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="buttonBarButtonStyle">@style/Widget.CleanGram.DialogButton</item>
    </style>
    <style name="Widget.CleanGram.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/shell_button_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/shell_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.CleanGram.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/shell_accent</item>
    </style>
    <style name="Widget.CleanGram.IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/shell_control_background</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">@color/shell_text</item>
    </style>
    <style name="Text.CleanGram.Heading">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/shell_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.CleanGram.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/shell_secondary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Theme.MyApplication" parent="Theme.CleanGram" />
</resources>